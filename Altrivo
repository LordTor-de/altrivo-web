<span style="font-family: Unbounded, sans-serif; font-weight: 600; font-size: 19px; color: #EEF1F7">Altrivo</span>
<span style="font-size: 14px">[BOLAGSNAMN AB] · Org.nr [XXXXXX-XXXX]</span>
<span style="font-size: 14px">[ADRESS], Stockholm</span>
</div>
<div style="max-width: 460px; font-size: 14px; line-height: 1.6">
<p style="margin: 0 0 8px; color: #EEF1F7; font-weight: 600">Ansvarsfull marknadsföring</p>
<p style="margin: 0">Vi annonserar endast för spelbolag med licens på respektive marknad och riktar aldrig spelreklam till personer under 18 år. Behöver du prata med någon om spel? Kontakta Stödlinjen.</p>
</div>
</div>
</footer>

</div>
<script>
(function(){
  var CONTACT='hej@altrivo.com';
  var accent='#35F2C2', accent2='#9B7BFF';
  var T={};
  T["bids"]=(b,i)=>`<div style="height: 33px; display: flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; border-bottom: 1px solid #161D2B">
<span style="width: 7px; height: 7px; border-radius: 999px; background: ${b.color}; flex: none"></span>
<span style="color: #EEF1F7; white-space: nowrap">${b.fmt} · ${b.vert} · ${b.geo}</span>
<span style="margin-left: auto; color: ${b.color}; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">${b.status}</span>
</div>`;
  T["marquee"]=(m,i)=>`<span style="display: inline-flex; align-items: center; gap: 22px; padding: 0 22px; font-family: Unbounded, sans-serif; font-weight: 500; font-size: 22px; color: ${m.color}; white-space: nowrap">${m.label}<span aria-hidden="true" style="color: #2E3850">/</span></span>`;
  T["services"]=(s,i)=>`<div class="card" style="background: #0E121C; border: 1px solid #1E2535; border-radius: 18px; padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #35F2C2">${s.num}</span>
<h3 style="margin: 0; font-family: Unbounded, sans-serif; font-weight: 500; font-size: 19px; line-height: 1.3">${s.title}</h3>
<p style="margin: 0; line-height: 1.6; color: #B7BFCE">${s.text}</p>
</div>`;
  T["tabs"]=(t,i)=>`${t.selected ? `
<button type="button" role="tab" aria-selected="true" data-click="pick" data-idx="${i}" style="border: none; background: #35F2C2; color: #07090F; padding: 12px 24px; border-radius: 999px; font-weight: 600; font-size: 16px; min-height: 44px; box-shadow: 0 0 24px -6px #35F2C2">${t.label}</button>
` : ""}
${t.notSelected ? `
<button type="button" role="tab" aria-selected="false" data-click="pick" data-idx="${i}" style="border: none; background: transparent; color: #EEF1F7; padding: 12px 24px; border-radius: 999px; font-weight: 600; font-size: 16px; min-height: 44px">${t.label}</button>
` : ""}`;
  T["v.kpis"]=(k,i)=>`<span style="padding: 9px 15px; border-radius: 999px; border: 1px solid #35F2C2; color: #35F2C2; font-size: 14px; font-weight: 600; background: rgba(53,242,194,.06)">${k}</span>`;
  T["v.compliance"]=(c,i)=>`<div style="display: flex; gap: 12px; align-items: flex-start">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#35F2C2" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="M20 6 9 17l-5-5"></path></svg>
<p style="margin: 0; line-height: 1.5; color: #D5DAE4">${c}</p>
</div>`;
  T["steps"]=(st,i)=>`<div class="card" style="background: #0E121C; border: 1px solid #1E2535; border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 10px">
<span style="font-family: Unbounded, sans-serif; font-weight: 700; font-size: 40px; color: #9B7BFF">${st.num}</span>
<h3 style="margin: 0; font-family: Unbounded, sans-serif; font-weight: 500; font-size: 18px">${st.title}</h3>
<p style="margin: 0; line-height: 1.6; color: #B7BFCE">${st.text}</p>
</div>`;
  T["team"]=(p,i)=>`<div class="card" style="background: #0E121C; border: 1px solid #1E2535; border-radius: 18px; padding: 28px; display: flex; flex-direction: column; gap: 16px">
<div style="width: 76px; height: 76px; border-radius: 20px; background: #141A28; border: 1px solid #9B7BFF; display: flex; align-items: center; justify-content: center; font-family: Unbounded, sans-serif; font-weight: 600; font-size: 20px; color: #9B7BFF">${p.initials}</div>
<div>
<h3 style="margin: 0 0 4px; font-family: Unbounded, sans-serif; font-weight: 500; font-size: 18px">${p.name}</h3>
<p style="margin: 0; color: #B7BFCE">${p.role}</p>
</div>
<p style="margin: 0; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #9AA3B5">${p.prev}</p>
</div>`;
  T["faqs"]=(f,i)=>`<div style="border-bottom: 1px solid #222B3E">
<button type="button" data-click="toggle" data-idx="${i}" aria-expanded="${f.expanded}" style="width: 100%; background: transparent; border: none; padding: 22px 0; display: flex; justify-content: space-between; align-items: center; gap: 16px; text-align: left; color: #EEF1F7; font-size: 18px; font-weight: 600; min-height: 44px">
<span>${f.q}</span>
<span aria-hidden="true" style="font-family: 'JetBrains Mono', monospace; font-size: 24px; color: #35F2C2; flex: none">${f.sign}</span>
</button>
${f.open ? `
<p style="margin: 0 0 24px; line-height: 1.65; color: #B7BFCE; max-width: 720px">${f.a}</p>
` : ""}
</div>`;

  var DATA={
    igaming:{headline:'iGaming: casino, sport och lotterier',intro:'Nå spelare som faktiskt konverterar, på licensierade marknader och i miljöer som passar ert varumärke. Vi bygger målgrupper kontextuellt och på förstapartsdata, och optimerar mot första insättning snarare än billiga klick.',kpis:['FTD / första insättning','CPA','Registreringar','ROAS / NGR'],clients:'Onlinecasinon, sportsbooks, poker- och bingosajter, lotterier och affiliates med egen licens.',compliance:['Åldersgräns 18+ och exkludering av målgrupper med låg ålder','Måttfull marknadsföring enligt spellagen','Geo-targeting endast mot marknader där ni har licens','Stödlinjen- och Spelpaus-hänvisningar i kreativen','Blocklistor för känsligt och olämpligt innehåll']},
    finans:{headline:'Finans: trading, sparande och betalningar',intro:'Nå sparare, tradare och företagare när de läser om ekonomi och marknader. Vi optimerar mot öppnade och verifierade konton och första insättning – och ser till att varningstexter och villkor alltid följer med.',kpis:['Öppnade konton','KYC-godkända kunder','Första insättning','CPA'],clients:'Nätmäklare, tradingplattformar, kryptobörser, fintech, banker, försäkring och betaltjänster.',compliance:['Riskvarningar för CFD, krypto och hävstångsprodukter','Annonsering i linje med Finansinspektionens och ESMA:s regler','Kontextuell placering i ekonomi- och nyhetsmiljöer','Exkludering av målgrupper under 18 år','Transparenta sajtlistor och brand safety-filter']},
    ovriga:{headline:'Fler branscher: e-handel, resor, B2B och mer',intro:'Samma erfarenhet och arbetssätt fungerar i alla branscher där målet är mätbar tillväxt. Vi sätter upp kampanjer mot försäljning, leads eller räckvidd – och optimerar mot det som faktiskt ger affär.',kpis:['Försäljning / ROAS','Leads','CPA','Räckvidd'],clients:'E-handel, resor, bil, telekom, B2B/SaaS och andra annonsörer som vill växa med programmatic.',compliance:['Brand safety-filter och transparenta sajtlistor','Skydd mot annonsbedrägerier och ogiltig trafik','Branschspecifika regler och varningstexter där det krävs','Hantering av samtycke och förstapartsdata enligt GDPR']}
  };
  var win=accent, block='#FF5D73', warn='#FFC857';
  var bidRows=[['Native','Sportsbook','SE','Vunnet',win],['Display','Nätmäklare','NO','Vunnet',win],['Video','Casino','DE','Ingen licens · stoppad',block],['CTV','Fintech','SE','Vunnet',win],['Display','Krypto','FI','Brand safety · filtrerad',warn],['Native','E-handel','DK','Vunnet',win],['Display','Lotteri','SE','Under 18 · exkluderad',block],['DOOH','Trading','SE','Vunnet',win],['Kontextuellt','Bank','SE','Vunnet',win]].map(function(r){return{fmt:r[0],vert:r[1],geo:r[2],status:r[3],color:r[4]}});
  var words=[['Casino','#FFC857'],['Trading',accent],['Sportsbook','#EEF1F7'],['Krypto',accent2],['Fintech',accent],['Poker','#FFC857'],['Banker','#EEF1F7'],['Lotteri',accent2],['Försäkring',accent],['E-handel','#EEF1F7'],['Resor',accent2],['B2B','#EEF1F7']].map(function(w){return{label:w[0],color:w[1]}});
  var S={
    bids:bidRows.concat(bidRows), marquee:words.concat(words),
    services:[['01','Managed programmatic','Vi planerar, sätter upp och optimerar kampanjen åt er i ledande DSP:er. Ni får en kontaktperson och veckovisa rapporter.'],['02','Flerkanalsplanering','Display, kontextuellt, native, DOOH, CTV och print i samma plan – vi fördelar budgeten efter vad som ger resultat.'],['03','Kontextuell & cookieless targeting','Målgrupper byggda på innehåll, förstapartsdata och sökordssignaler – robust när tredjepartscookies försvinner.'],['04','Retargeting & lookalikes','Återaktivera besökare som inte konverterade och hitta nya som liknar era bästa kunder.'],['05','Rapport & attribution','Koppling till er tracking och affiliate-/MMP-data, så att vi optimerar mot riktiga intäkter.'],['06','Brand safety & compliance','Sajtlistor, åldersfilter, geo-licenser och varningstexter – kontrollerat innan första visningen.']].map(function(a){return{num:a[0],title:a[1],text:a[2]}}),
    steps:[['01','Behovsanalys','Mål, marknader, licenser, budget och befintlig tracking. Vi säger ärligt om programmatic passar er.'],['02','Mediaplan & setup','Format, målgrupper, sajtlistor och compliance-krav sätts upp och godkänns av er.'],['03','Lansering & optimering','Testperiod med tydliga mål. Vi optimerar bud, placeringar och kreativ löpande.'],['04','Rapport & skalning','Det som fungerar får mer budget. Det som inte gör det stängs av.']].map(function(a){return{num:a[0],title:a[1],text:a[2]}}),
    team:[{initials:'S1',name:'[NAMN EFTERNAMN]',role:'Partner & säljare',prev:'Tidigare: Match2One'},{initials:'S2',name:'[NAMN EFTERNAMN]',role:'Partner & säljare',prev:'Tidigare: [TIDIGARE ARBETSGIVARE]'},{initials:'S3',name:'[NAMN EFTERNAMN]',role:'Partner & säljare',prev:'Tidigare: [TIDIGARE ARBETSGIVARE]'}]
  };
  var FAQ=[['Jobbar ni bara med iGaming och finans?','Nej. iGaming och finans är där vi har djupast erfarenhet, särskilt av regler och compliance, men vi kör programmatic för alla branscher.'],['Vad är programmatisk annonsering?','Automatiserat köp av annonsplatser i realtid via budgivning. Istället för att boka sajt för sajt köper vi rätt visning till rätt person, på tusentals sajter, och betalar bara för det som matchar målgruppen.'],['Hur stor budget behövs för att testa?','Det beror på marknad och mål. Vi rekommenderar en testperiod som är tillräckligt stor för att ge säkra slutsatser – det räknar vi fram tillsammans på första mötet. [ER MINIMIBUDGET]'],['Annonserar ni för spelbolag utan svensk licens?','Nej. Vi riktar bara kampanjer mot marknader där annonsören har giltig licens.'],['Hur tar ni betalt?','[ER PRISMODELL – t.ex. procent av mediaspend eller fast månadsavgift]. Mediakostnad och avgift redovisas alltid separat.'],['Kan vi se var annonserna visas?','Ja. Ni får sajtlistor och placeringsrapporter, och kan blocka eller prioritera sajter när som helst.']];
  var state={vertical:'igaming',openFaq:0};
  function render(name,list){document.querySelectorAll('[data-for="'+name+'"]').forEach(function(el){el.innerHTML=list.map(T[name]).join('')})}
  function txt(id,v){var e=document.getElementById(id);if(e)e.textContent=v}
  function renderVertical(){
    var v=DATA[state.vertical];
    render('tabs',[['igaming','iGaming'],['finans','Finans'],['ovriga','Fler branscher']].map(function(t){return{label:t[0]===t[0]?t[1]:'',selected:t[0]===state.vertical,notSelected:t[0]!==state.vertical}}));
    txt('v-headline',v.headline);txt('v-intro',v.intro);txt('v-clients',v.clients);
    render('v.kpis',v.kpis);render('v.compliance',v.compliance);
  }
  function renderFaq(){
    render('faqs',FAQ.map(function(f,i){var open=state.openFaq===i;return{q:f[0],a:f[1],open:open,expanded:open?'true':'false',sign:open?'−':'+'}}));
  }
  var VIDS=['igaming','finans','ovriga'];
  document.addEventListener('click',function(e){
    var b=e.target.closest('[data-click]');if(!b)return;
    var i=+b.getAttribute('data-idx'),act=b.getAttribute('data-click');
    if(act==='pick'){state.vertical=VIDS[i];renderVertical()}
    if(act==='toggle'){state.openFaq=state.openFaq===i?-1:i;renderFaq()}
  });
  function fmt(n){return Math.round(n).toLocaleString('sv-SE')}
  function calc(){
    var b=+document.getElementById('budget').value,c=+document.getElementById('cpm').value,r=+document.getElementById('ctr').value;
    var imp=b/c*1000;
    txt('o-budget',fmt(b)+' kr');txt('o-cpm',c+' kr');txt('o-ctr',r.toFixed(2).replace('.',',')+' %');
    txt('o-imp',fmt(imp));txt('o-clicks',fmt(imp*r/100));
  }
  ['budget','cpm','ctr'].forEach(function(id){document.getElementById(id).addEventListener('input',calc)});
  ['bids','marquee','services','steps','team'].forEach(function(k){render(k,S[k])});
  renderVertical();renderFaq();calc();
  // form
  var form=document.getElementById('kontaktform'),err=document.getElementById('form-error');
  form.addEventListener('submit',function(e){
    var n=form.namn.value.trim(),m=form.epost.value.trim(),msg='';
    if(!n)msg='Fyll i ditt namn.';else if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(m))msg='Fyll i en giltig e-postadress.';
    if(msg){e.preventDefault();txt('o-error',msg);err.hidden=false;return}
    e.preventDefault();
    var vl=({igaming:'iGaming',finans:'Finans',annat:'Annan bransch'})[form.bransch.value];
    var body='Namn: '+n+'\nE-post: '+m+'\nBolag: '+form.bolag.value+'\nBransch: '+vl+'\nBudget: '+(form.budget.options[form.budget.selectedIndex].text)+'\n\n'+form.meddelande.value;
    location.href='mailto:'+CONTACT+'?subject='+encodeURIComponent('Förfrågan från '+n+(form.bolag.value?' ('+form.bolag.value+')':''))+'&body='+encodeURIComponent(body);
    txt('o-name',n);txt('o-email',m);txt('o-vlabel',({igaming:'iGaming',finans:'finans'})[form.bransch.value]||'programmatic');
    document.getElementById('sent-box').hidden=false;form.hidden=true;
  });
  form.addEventListener('input',function(){err.hidden=true});
  document.getElementById('reset-btn').addEventListener('click',function(){document.getElementById('sent-box').hidden=true;form.hidden=false;form.reset();});
})();
</script>
</body>
</html>
